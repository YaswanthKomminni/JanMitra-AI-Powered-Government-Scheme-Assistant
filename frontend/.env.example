# Copy to .env.local and fill in. Never commit .env.local.
# These values are read ONLY on the server; nothing here is sent to the browser.

# --- MySQL (required) -------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
# Use a dedicated MySQL user with rights on the JanMithra schema only (not root).
DB_USER=janmitra_app
DB_PASSWORD=change-me
DB_NAME=JanMithra
# DB_POOL_SIZE=10

# --- Sessions & security (optional, sensible defaults) ---------------
# How long a sign-in lasts, in days.
# SESSION_TTL_DAYS=7
# bcrypt work factor for password hashing (10-14).
# BCRYPT_COST=12
# Session cookie "Secure" flag. Defaults to true when NODE_ENV=production.
# Set to false only if you run `npm start` over plain http on a LAN.
# COOKIE_SECURE=
# Max successful-format sign-ups per IP per hour (CSC kiosks share one IP).
# SIGNUP_RATE_LIMIT_PER_HOUR=30

# --- Development only -------------------------------------------------
# Makes /api/chat fail after saving the question, to test the Retry flow.
# Ignored when NODE_ENV=production.
# JANMITRA_SIMULATE_AI_FAILURE=1
