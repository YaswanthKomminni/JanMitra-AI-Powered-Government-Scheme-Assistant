# Copy to .env.local and fill in. Never commit .env.local.
# These values are read ONLY on the server; nothing here is sent to the browser.

# --- PostgreSQL (required) --------------------------------------------
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Use a dedicated PostgreSQL role with rights on this database only (not a superuser).
# URL-encode special characters in the password (e.g. @ becomes %40).
# For a server that requires TLS, append ?sslmode=require
DATABASE_URL=postgresql://janmitra_app:change-me@127.0.0.1:5432/janmitra
# DB_POOL_SIZE=10

# --- Sessions & security (optional, sensible defaults) ---------------
# How long a sign-in lasts, in days.
# SESSION_TTL_DAYS=7
# bcrypt work factor for password hashing (10-14).
# BCRYPT_COST=12
# Session cookie "Secure" flag. Defaults to true when NODE_ENV=production.
# Set to false only if you run `npm start` over plain http on a LAN.
# COOKIE_SECURE=
# Max successful-format sign-ups per IP per hour (CSC kiosks share one IP).
# SIGNUP_RATE_LIMIT_PER_HOUR=30

# --- Vision & Multimodal LLM (optional, enables cloud Vision LLM) ----
# Provide a Gemini API key for deep multimodal crop disease & document inspection.
# If not set, JanMithra automatically uses its built-in local Vision OCR engine.
# GEMINI_API_KEY=AIzaSy...
# GROQ_API_KEY=gsk_...
# OPENAI_API_KEY=sk-...
# Optional model overrides (server-side only). Defaults use current provider catalogs.
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_VISION_MODEL=gemini-3.8-flash
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_VISION_MODEL=qwen/qwen3.8-27b
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_VISION_MODEL=gpt-4o-mini
# Local OCR languages: install/cache the matching Tesseract language data first.
# OCR_LANGUAGES=eng+tel+hin+tam+kan+ben
# OCR_LANG_PATH=/path/to/tessdata

# --- Development only -------------------------------------------------
# Makes /api/chat fail after saving the question, to test the Retry flow.
# Ignored when NODE_ENV=production.
# JANMITRA_SIMULATE_AI_FAILURE=1

# --- One-off MySQL -> PostgreSQL data transfer (optional) -------------
# Only used by `npm run db:transfer-mysql`; see README.
# MYSQL_URL=mysql://readonly_user:change-me@127.0.0.1:3306/JanMithra

